<%-
  ppn = num_cores.blank? ? 96 : num_cores.to_i

  case node_type
  when "largemem"
    slurm_args = [ "--ntasks-per-node", "#{ppn}", "--partition", "hugemem" ]
  when "gpu"
    slurm_args = [ "--ntasks-per-node", "#{ppn}", "--gpus-per-node", "1" ]
  else
    slurm_args = [ "--ntasks-per-node", "#{ppn}" ]
  end
%>
---
batch_connect:
  template: basic
script:
  native:
  <%- slurm_args.each do |arg| %>
    - "<%= arg %>"
  <%- end %>
