#!/bin/bash

module purge
module restore

module load <%= context.auto_modules_ollama %>
export OLLAMA_PORT=$port_ollama
export OPEN_WEBUI_PORT=$port_openwebui

source ollama_start_helper
source open_webui_start_helper

apptainer run --writable-tmpfs \
    --env FORWARD_PORT=${port} \
    --env FORWARD_HOST=${host} \
    --env OPENWEBUI_PORT=${port_openwebui} \
    -B ./templates:/etc/nginx/templates \
    -B ./:/var/log/nginx/ \
    -B ./conf:/etc/nginx/conf.d/ \
    ./nginx-unprivileged_stable-alpine.sif